Options -MultiViews -Indexes

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /crm/

    # Serve real files/directories as-is (assets, favicon, etc.)
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # SPA fallback: every other path is a client-side route → index.html
    RewriteRule ^ index.html [L]
</IfModule>

# ── Cache policy ────────────────────────────────────────────────────────────
# Without this the app serves a stale build after every deploy.
#
# index.html is the only file whose URL never changes, and it is what names the
# current bundle (<script src="assets/index-<hash>.js">). With no Cache-Control
# on it, browsers fall back to heuristic caching and keep reusing the copy they
# already have — which still points at the PREVIOUS hash. That old file is
# usually still sitting on the server, because deploying by unzipping over the
# existing folder adds the new assets without removing the old ones, so the
# stale reference resolves happily and the agent keeps running yesterday's code
# with no error anywhere. Revalidate it on every load.
<IfModule mod_headers.c>
    # Vite fingerprints everything it emits as name-<8+ char hash>.ext, so a
    # changed file always arrives under a new URL and can be cached forever.
    # Matching the hash pattern (rather than the extension) deliberately leaves
    # out the un-fingerprinted files copied from public/ — favicon.svg,
    # icons.svg, truckmitr-logo.png — which DO get replaced in place and must
    # not be pinned for a year.
    <FilesMatch "-[A-Za-z0-9_-]{8,}\.(js|css|webp|png|jpe?g|gif|svg|woff2?)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>

    <FilesMatch "\.html$">
        Header set Cache-Control "no-cache, must-revalidate"
    </FilesMatch>
</IfModule>
