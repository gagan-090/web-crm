Options -MultiViews -Indexes

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /crm/

  
    # teleui is now a React client-side route (public wall-board), served by the
    # SPA like theme/web-roles — no separate static file.
    RewriteRule ^(theme|web-roles|teleui)/?$ index.html [L]

    # Serve real files/directories as-is (assets, favicon, etc.)
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # SPA fallback: every other path is a client-side route → index.html
    RewriteRule ^ index.html [L]
</IfModule>


<IfModule mod_headers.c>
  
    <FilesMatch "-[A-Za-z0-9_-]{8,}\.(js|css|webp|png|jpe?g|gif|svg|woff2?)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>

    <FilesMatch "\.html$">
        Header set Cache-Control "no-cache, must-revalidate"
    </FilesMatch>
</IfModule>
